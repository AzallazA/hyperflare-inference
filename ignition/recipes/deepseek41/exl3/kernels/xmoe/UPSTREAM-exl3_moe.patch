-    return (int*) locks[device];
+    return (int*) slot[device];
+}
+
+// Both buffers are allocated on first use of either, so a side-stream launch never allocates inside graph capture
+int* DevCtx::get_locks(int device)
+{
+    std::lock_guard<std::mutex> lock(mtx);
+    alloc_locks(locks_alt, device);
+    return alloc_locks(locks, device);
+}
+
+int* DevCtx::get_locks_alt(int device)
+{
+    std::lock_guard<std::mutex> lock(mtx);
