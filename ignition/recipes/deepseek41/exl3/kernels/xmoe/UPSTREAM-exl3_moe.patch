+    // Pipe 0: global -> shared
+    int slice0_k = slice_beg % tiles_k;
+    int col0 = slice_beg / tiles_k;
+    int slice0_iters = slice_len;
+
+    const int gl_a_stride_k = TILESIZE_K;
