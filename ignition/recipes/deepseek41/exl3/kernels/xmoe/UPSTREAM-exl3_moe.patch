+            ld_issue(bc);                                    // first use of buffers 0 .. D - 1: no 'empty' wait
+            xp_cp_async_arrive(bar_full + 8 * decltype(bc)::value);
+        }
+    });
+
+    clear_frag_c();
+
+    int slot = 0;
+    do slot = two_halves ? run(std::true_type{}, slot) : run(std::false_type{}, slot);
+    while (slot >= 0);
+
+    if constexpr (MBAR)
+    {
+        // Drain: stages slice_len .. slice_len + D - 1 got (copy-less) arrivals on 'full' from the refill hooks of the last
+        // D stages (and from the prologue when slice_len < D). Wait for those phases so that no cp.async arrive-on is
+        // still pending, then everybody is past every wait and thread 0 invalidates the ring.
+        for (int c = slice_len; c < slice_len + D; ++c) xp_mbar_wait(bar_full + 8 * (c % NBUF), (uint32_t) (c / NBUF) & 1);
+        __syncthreads();
+        if (T == 0)
+        {
+            #pragma unroll
+            for (int b = 0; b < 2 * NBUF; ++b) xp_mbar_inval(bar_full + 8 * b);
+        }
+    }
+}
diff -ruN a/quant/exl3_gemm_inner_flat_t.cuh b/quant/exl3_gemm_inner_flat_t.cuh
--- a/quant/exl3_gemm_inner_flat_t.cuh	1969-12-31 16:00:00.000000000 -0800
+++ b/quant/exl3_gemm_inner_flat_t.cuh	2026-10-20 08:40:39.790718433 -0700
@@ -0,0 +1,591 @@
+#pragma once
+
+// xmoe_ds41t (2026-10-19): hot-trimmed stage loop of the flat MoE GEMM.
+//
+// Bit-identical to exl3_gemm_kernel_inner_flat (the ds41a loop; exl3_gemm_inner_flat.cuh is unchanged and still included
+// for FlatGemmJobs and by the dense path, but the MoE flat kernel now calls this function instead):
+// same slice split over the grid, same tile layout in shared memory, same decode (the dq8 / dq8_aligned_2bits integer
+// sequence and decode_3inst_2), same HMMA operands and order per output, same sub_k reduction, same column-lock protocol
+// and fp16 partial sums. Only the bookkeeping around the math changed. On exl3_moe_flat_kernel<3,128,2> (ds41a) one
+// 128x128 stage costs ~247 warp-instructions per warp, ~25 % of it bookkeeping; here:
+//  * shared-memory addresses are 32-bit values computed once per GEMM phase and used as [reg+imm] operands of
+//    ld.shared / ldmatrix / cp.async (inline PTX); the stage buffer is a compile-time immediate because the loop body is
+//    unrolled over the buffer ring. The per-stage S2UR/LEA/IMAD rebuild (setup block) and the per-k-block ldmatrix IMADs
+//    are gone, so are the constant re-materializations (0x6400 / 0x1eee / 0x1010101 MOVs).
+//  * no runtime-indexed FlatGemmJobs arrays: A[mat], B[mat], C[mat] are selects (removes the 168 B stack frame and the
+//    LDL loads on every column change)
+//  * column bookkeeping by run counters: per stage one decrement + test for the copy pipe and one for the MMA pipe; the
+//    (n-tile, job) position advances incrementally, no integer division inside the loop
+//  * per-thread global copy pointers advanced by one 64-bit add per stage
+//  * the second token-half HMMA (jobs with > 8 rows) is a compile-time branch: the loop is instantiated for both cases
+//    and re-dispatched at a segment boundary where the row count crosses 8. ds41a issued it predicated off in decode
+//    (<= 8 rows per expert): 4 issue slots per stage, 3.3 % of the kernel's stall samples (ncu, T=6)
+//  * the MUL1 decode constants and the B copy address are pinned in registers (see xt_pin)
+//  * XMOE_T_NBUF stage buffers: 2 (default) = the ds41a pipeline, copies one stage ahead of the MMAs; 3 prefetches two
+//    stages ahead (10 KB more shared memory). Both produce identical results (data movement only). One barrier per stage
+//    either way: two stages per barrier was measured in SASS (+1.5 instructions/stage: the copy burst splits in two).
+// The three "@!PT LDS RZ, [RZ]" in front of the copy burst stay: ptxas emits them before every LDGSTS burst on sm_80+
+// (even before the first copy of a kernel, see hottrim/tools/exp_ldgsts.cu), so only a non-LDGSTS copy path removes them.
+
+#include <utility>
+#include "../ptx.cuh"
+#include "exl3_dq.cuh"
+#include "exl3_gemm_inner_flat.cuh"   // FlatGemmJobs
+
+#ifndef XMOE_T_NBUF
+#define XMOE_T_NBUF 2
+#endif
+// XMOE_T_FOLD=1 (opt-in, NOT bit-identical; K=3 MUL1 only): the codebook scale/offset of decode_3inst_2<2> is folded out
+// of the inner decode. The MMA runs on h = 1024 + n (exact in fp16, no per-weight HFMA2), one extra MMA per k-block with
+// an all-ones A operand accumulates sum_k x_k, and each MMA segment is mapped back once before the reduce:
+// acc = k_inv * acc_h + k_bias * sum_k x_k. -16 HFMA2 +4 HMMA per stage and warp. Numerics: the fp16 rounding of every
+// decoded weight disappears, so results differ from ds41a by that rounding: ~2.1e-4 relative L2 (tools/fold_error.py:
+// ds41a vs exact codebook math 2.1e-4, fold vs exact 2.5e-6), below the fp16 rounding of the GEMM outputs (4.9e-4).
+#ifndef XMOE_T_FOLD
+#define XMOE_T_FOLD 0
+#endif
+
+// ---- compile-time unrolling (immediate offsets need constant indices) -------------------------------------------------
+template <typename F, int... I>
+__device__ __forceinline__ void xt_unroll_seq(F& f, std::integer_sequence<int, I...>) { (f(std::integral_constant<int, I>{}), ...); }
+template <int N, typename F>
+__device__ __forceinline__ void xt_unroll(F&& f) { xt_unroll_seq(f, std::make_integer_sequence<int, N>{}); }
+
+// ---- shared-memory access with 32-bit [reg+imm] addresses -------------------------------------------------------------
+// volatile: keeps them ordered against the barriers / cp.async waits at the NVVM level (ptxas still schedules freely)
+template <int OFF>
+__device__ __forceinline__ uint32_t xt_lds32(uint32_t a)
+{
+    uint32_t v;
+    asm volatile ("ld.shared.b32 %0, [%1+%2];\n" : "=r"(v) : "r"(a), "n"(OFF));
+    return v;
+}
+
+template <int OFF>
+__device__ __forceinline__ void xt_ldsm4(FragA& f, uint32_t a)
+{
+    uint32_t* r = reinterpret_cast<uint32_t*>(&f);
+    asm volatile ("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4+%5];\n"
+                  : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(a), "n"(OFF));
+}
+
+template <int OFF>
+__device__ __forceinline__ void xt_cp_async(uint32_t s, const void* g)
+{
+    asm volatile ("cp.async.cg.shared.global [%0+%2], [%1], 16;\n" :: "r"(s), "l"(g), "n"(OFF));
+}
+
+// Identity shuffle: ptxas does not re-materialize SHFL results, so values that would otherwise be rebuilt from special
+// registers (SR_CgaCtaId -> shared window) or immediates inside the loop stay in registers. One SHFL per GEMM phase.
+__device__ __forceinline__ uint32_t xt_pin(uint32_t v) { return __shfl_sync(0xffffffffu, v, threadIdx.x % 32); }
+
+// ---- decode ------------------------------------------------------------------------------------------------------------
+// decode_3inst_2<2> (codebook.cuh) with its constants in registers: x * 0x83DCD12D, dp4a byte sum + 0x6400, fp16 fma
+// with k_inv 0x1eee / k_bias 0xc931. Same instructions and operands, so the same bits.
+struct XtMul1K
+{
+    uint32_t k_ones, k_acc;
+    half2 k_inv_h2, k_bias_h2;
+    __device__ __forceinline__ void init()
+    {
+        k_ones = xt_pin(0x01010101u);
+        k_acc = xt_pin(0x6400u);
+        k_inv_h2 = __half2half2(__ushort_as_half(0x1eee));   //  0.00677 = 1/147.7
+        k_bias_h2 = __half2half2(__ushort_as_half(0xc931));  // -10.39 = (-1024.0 - 510.0) * k_inv_h
+        half2_uint32 ki(k_inv_h2);
+        k_inv_h2 = half2_uint32(xt_pin(ki.as_uint32)).as_half2;
+    }
+};
+
+template <int cb, bool FOLD = false>
+__device__ __forceinline__ half2 xt_decode2(uint32_t x0, uint32_t x1, const XtMul1K& K)
+{
+    if constexpr (cb == 2)
+    {
+        x0 *= 0x83DCD12Du;
+        x1 *= 0x83DCD12Du;
+        uint32_t sum0 = __dp4a(x0, K.k_ones, K.k_acc);
+        uint32_t sum1 = __dp4a(x1, K.k_ones, K.k_acc);
+        half_uint16 h0((uint16_t) sum0);
+        half_uint16 h1((uint16_t) sum1);
+        if constexpr (FOLD) return __halves2half2(h0.as_half, h1.as_half);   // h = 1024 + n; scale/offset after the MMA
+        else return __hfma2(__halves2half2(h0.as_half, h1.as_half), K.k_inv_h2, K.k_bias_h2);
+    }
+    else
+    {
+        return decode_3inst_2<cb>(x0, x1);
+    }
+}
+
+// Per-lane constants of dq_dispatch<bits, cb>(ptr, lane << 3, frag0, frag1): the two 32-bit words a lane reads from its
+// 16x16 tile, and the decode from them, as in exl3_dq.cuh (same integer ops, same codebook calls -> identical fp16 weights).
+template <int bits> struct XtDq;
+
+template <> struct XtDq<3>   // dq8<3, cb, 4>
+{
+    int wi0, wi1, s, s4;
+    __device__ __forceinline__ void init(int t_offset)
+    {
+        const int b1 = (t_offset + 257) * 3;
+        const int b0 = b1 - 16;
+        const int b2 = b1 + 3 * 7;
+        const int i0 = b0 / 32;
+        const int i2 = (b2 - 1) / 32;
+        s = (i2 + 1) * 32 - b2;
+        s4 = s + 3 * 4;
+        wi0 = i0 % (3 * 256 / 32);
+        wi1 = i2 % (3 * 256 / 32);
+    }
+    template <int cb, bool FOLD = false>
+    __device__ __forceinline__ void decode(uint32_t a, uint32_t b, FragB& frag0, FragB& frag1, const XtMul1K& K) const
+    {
+        const uint32_t w7 = fshift(b, a, s);
+        const uint32_t w6 = w7 >> 3;
+        const uint32_t w5 = w6 >> 3;
+        const uint32_t w4 = w5 >> 3;
+        const uint32_t w3 = fshift(b, a, s4);
+        const uint32_t w2 = w3 >> 3;
+        const uint32_t w1 = w2 >> 3;
+        const uint32_t w0 = w1 >> 3;
+        frag0[0] = xt_decode2<cb, FOLD>(w0 & 0xffff, w1 & 0xffff, K);
+        frag0[1] = xt_decode2<cb, FOLD>(w2 & 0xffff, w3 & 0xffff, K);
+        frag1[0] = xt_decode2<cb, FOLD>(w4 & 0xffff, w5 & 0xffff, K);
+        frag1[1] = xt_decode2<cb, FOLD>(w6 & 0xffff, w7 & 0xffff, K);
+    }
+};
+
+template <> struct XtDq<2>   // dq8_aligned_2bits<cb>
+{
+    int wi0, wi1, s, s4;
+    __device__ __forceinline__ void init(int t_offset)
+    {
+        wi1 = t_offset >> 4;
+        wi0 = (wi1 + 15) & 15;
+        s = ((~t_offset) & 8) << 1;
+        s4 = 0;
+    }
+    template <int cb, bool FOLD = false>
+    __device__ __forceinline__ void decode(uint32_t a, uint32_t b, FragB& frag0, FragB& frag1, const XtMul1K& K) const
+    {
+        static_assert(!FOLD, "xmoe ds41t: fold is K=3 MUL1 only");
+        uint32_t w0, w1, w2, w3, w4, w5, w6, w7;
+        b = fshift(b, a, s);
+        w7 = b & 0xffff;
+        BFE16_IMM(w6, b, 2);
+        BFE16_IMM(w5, b, 4);
+        BFE16_IMM(w4, b, 6);
+        BFE16_IMM(w3, b, 8);
+        BFE16_IMM(w2, b, 10);
+        BFE16_IMM(w1, b, 12);
+        BFE16_IMM(w0, b, 14);
+        frag0[0] = xt_decode2<cb>(w0, w1, K);
+        frag0[1] = xt_decode2<cb>(w2, w3, K);
+        frag1[0] = xt_decode2<cb>(w4, w5, K);
+        frag1[1] = xt_decode2<cb>(w6, w7, K);
+    }
+};
+
+template<EXL3_GEMM_T_ARGS>
+inline __device__
+void exl3_gemm_kernel_inner_flat_t
+(
+    const FlatGemmJobs& jobs,
+    const int size_k,
+    const int size_n,
+    int* __restrict__ locks
+)
+{
+    static_assert(!c_fp32, "xmoe flat: fp16 output only");
+    constexpr int NBUF = SH_STAGES;                                          // stage buffers (XMOE_T_NBUF)
+    constexpr bool FOLD = XMOE_T_FOLD && bits == 3 && cb == 2;               // opt-in, not bit-identical (see top)
+    static_assert(NBUF == 2 || NBUF == 3, "xmoe ds41t: 2 or 3 stage buffers");
+    const int blocks_n_full = size_n / 16;
+    constexpr int TILEBLOCKS_K = TILESIZE_K / 16;
+    constexpr int TILEBLOCKS_N = TILESIZE_N / 16;
+    constexpr int KPS = TILEBLOCKS_K / 2;                                    // k-blocks per sub_k group
+    constexpr int NT = 2 * EXL3_GEMM_BASE_THREADS;                           // threads per block
+    constexpr int FRAGS_N_PER_WARP = 2 * TILEBLOCKS_N / (EXL3_GEMM_BASE_THREADS / 32);
+
+    constexpr int sh_a_stage_size = TILESIZE_M * TILESIZE_K;                 // halfs
+    constexpr int sh_b_stage_size = TILEBLOCKS_K * TILEBLOCKS_N * 16 * bits; // uint16s
+    constexpr int SA_BYTES = sh_a_stage_size * 2;
+    constexpr int SB_BYTES = sh_b_stage_size * 2;
+
+    constexpr int A_COLS = TILESIZE_K / 8;
+    constexpr int A_SWIZZLE_MASK = A_COLS - 1;
+    constexpr int A_SWIZZLE_SHIFT = A_COLS <= 2 ? 2 : (A_COLS == 4 ? 1 : 0);   // 128-byte rows: xor with the row itself
+
+    static_assert(EXL3_GEMM_BASE_THREADS == 256);
+    static_assert(TILESIZE_M == 16, "Invalid kernel params");
+    static_assert(TILEBLOCKS_K % 2 == 0, "xmoe flat: two sub_k groups");
+    static_assert(TILESIZE_N % 128 == 0, "Invalid kernel params");
+    static_assert(FRAG_STAGES == 1, "xmoe_k64: fragments are consumed in the stage that decodes them");
+    static_assert(EXL3_GEMM_H_ACC == 0, "xmoe flat: fp16 accumulation not supported");
+    static_assert(SMEM_MAX >= NBUF * (2 * sh_a_stage_size + 2 * sh_b_stage_size) + 4 * EXL3_GEMM_BASE_THREADS * FRAGS_N_PER_WARP * 4,
+                  "Invalid kernel params (insufficient shared memory for shape)");
+
+    extern __shared__ half shared[];
+    half* sh_a = shared;
+    uint16_t* sh_b = (uint16_t*) (sh_a + NBUF * sh_a_stage_size);
+    float* sh_c = (float*) (sh_b + sh_b_stage_size * NBUF);
+    const uint32_t sm_a = (uint32_t) __cvta_generic_to_shared(sh_a);
+    const uint32_t sm_b = (uint32_t) __cvta_generic_to_shared(sh_b);
+
+    const int T = threadIdx.x;
+    const int t = threadIdx.x % EXL3_GEMM_BASE_THREADS;
+    const int sub_k = threadIdx.x / EXL3_GEMM_BASE_THREADS;
+    const int warp_id = t / 32;
+    const int lane_id = t % 32;
+
+    const int tiles_k = size_k / TILESIZE_K;
+    const int tiles_n = size_n / TILESIZE_N;
+    const int num_jobs = jobs.num_jobs;
+    const int total_cols = num_jobs * jobs.num_mats * tiles_n;
+    const int total_slices = tiles_k * total_cols;
+
+    const int num_slices = gridDim.x;
+    const int slice_beg = (int) ((int64_t) total_slices * blockIdx.x / num_slices);
+    const int slice_end = (int) ((int64_t) total_slices * (blockIdx.x + 1) / num_slices);
+    const int slice_len = slice_end - slice_beg;
+    if (slice_len < 1) return;
+
+    // First column of the block: col = q * tiles_n + n, q = job index over both matrices (q >= num_jobs: matrix 1)
+    const int col_beg = slice_beg / tiles_k;
+    const int k_beg = slice_beg % tiles_k;
+
+    const int gl_a_stride_k = TILESIZE_K;
+    const int gl_b_stride_k = blocks_n_full * TILEBLOCKS_K * 16 * bits;
+    constexpr int gl_b_stride_n = TILEBLOCKS_N * 16 * bits;
+
+    // Copy assignment as in ds41a (one 16-byte copy of B per thread j = T < NB4, one of A per thread j = NT - 1 - T < NA4)
+    constexpr int NA4 = TILESIZE_M * TILESIZE_K / 8;
+    constexpr int NB4 = sh_b_stage_size / 8;
+    static_assert(NA4 <= NT && NB4 <= NT, "xmoe ds41t: at most one A and one B 16-byte copy per thread and stage");
+    const int ja = NT - 1 - T;
+    const int a_k = ja % A_COLS;
+    const int a_m = ja / A_COLS;
+    const bool pa_thread = ja < NA4;
+    const int load_a_gl = a_m * size_k / 8 + a_k;
+    const uint32_t cp_a_s = xt_pin(sm_a + 16 * (a_m * A_COLS + (a_k ^ ((a_m >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK))));
+    const int jb = T;
+    const int b_n = jb % (gl_b_stride_n / 8);
+    const int b_k = jb / (gl_b_stride_n / 8);
+    const int load_b_gl = b_k * (blocks_n_full * 16 * bits / 8) + b_n;
+    const bool pb_thread = jb < NB4;
+    const uint32_t cp_b_s = xt_pin(sm_b + 16 * jb);
+    const int gb_step = gl_b_stride_k / 8;   // int4 per k-tile
+    constexpr int ga_step = TILESIZE_K / 8;
+
+    // ---- pipe 0: global -> shared ----
+    int ld_n = col_beg % tiles_n, ld_q = col_beg / tiles_n, ld_k = k_beg;
+    int ld_left = slice_len;   // slices not yet assigned to a copy segment
+    int ld_run;                // copies left in the current segment
+    const int4* gA;
+    const int4* gB;
+    bool pA, pB;
+    auto ld_set = [&] ()
+    {
+        const int mat = ld_q >= num_jobs ? 1 : 0;
+        const int j = ld_q - (mat ? num_jobs : 0);
+        const int rows0 = jobs.rows[j];
+        const half* A = mat ? jobs.A[1] : jobs.A[0];
+        const uint16_t* const* Bt = mat ? jobs.B[1] : jobs.B[0];
+        const half* gl_a_ptr = A + (size_t) jobs.start[j] * size_k + ld_k * gl_a_stride_k;
+        const uint16_t* gl_b_ptr = Bt[jobs.expert[j]] + ld_k * gl_b_stride_k + ld_n * gl_b_stride_n;
+        gA = (const int4*) gl_a_ptr + load_a_gl;
+        gB = (const int4*) gl_b_ptr + load_b_gl;
+        pA = pa_thread && a_m < rows0;
+        pB = pb_thread;
+        const int seg = min(tiles_k - ld_k, ld_left);
+        ld_run = seg;
+        ld_left -= seg;
+    };
+    ld_set();
+
+    auto ld_issue = [&] (auto lbuf)
+    {
+        constexpr int LB = decltype(lbuf)::value;
+        if (pB) xt_cp_async<LB * SB_BYTES>(cp_b_s, gB);
+        if (pA) xt_cp_async<LB * SA_BYTES>(cp_a_s, gA);
+        gA += ga_step;
+        gB += gb_step;
+        if (--ld_run == 0)
+        {
+            if (ld_left == 0)
+            {
+                pA = false; pB = false;
+                ld_run = 1 << 30;
+            }
+            else
+            {
+                ld_k = 0;
+                if (++ld_n == tiles_n) { ld_n = 0; ++ld_q; }
+                ld_set();
+            }
+        }
+    };
+
+    // ---- pipe 2: MMA and output ----
+    int cp_col = col_beg, cp_n = col_beg % tiles_n, cp_q = col_beg / tiles_n, cp_k = k_beg;   // cp_k = first k of the segment
+    int cp_left = slice_len;
+    int cp_seg, cp_run, rows2;
+    bool two_halves;
+    half* gl_c_ptr_16;
+    auto cp_set = [&] ()
+    {
+        const int mat = cp_q >= num_jobs ? 1 : 0;
+        const int j = cp_q - (mat ? num_jobs : 0);
+        rows2 = jobs.rows[j];
+        two_halves = rows2 > 8;
+        gl_c_ptr_16 = (mat ? jobs.C[1] : jobs.C[0]) + (size_t) jobs.start[j] * size_n + cp_n * TILESIZE_N;
+        cp_seg = min(tiles_k - cp_k, cp_left);
+        cp_run = cp_seg;
+        cp_left -= cp_seg;
+    };
+    cp_set();
+
+    // xmoe_swap: operands swapped (C'[col][token] = W^T X^T): the decoded 16x16 weight tile is the m16k16 A operand
+    // and <= 8 tokens are the n8 B operand, so one HMMA covers 256 weights instead of 128 when a job has <= 8 rows.
+    constexpr int NB16 = FRAGS_N_PER_WARP / 2;   // 16-column blocks per warp
+    register FragC frag_c[2][NB16];               // [token half][column block]
+    register FragC frag_x[2];                     // FOLD: sum_k x_k per token (ones-MMA), same C layout as frag_c[h][*]
+
+    // ldmatrix x4 over the token tile: m0 = rows 0-7 k 0-7, m1 = rows 0-7 k 8-15, m2/m3 = rows 8-15 -> B' fragments for both halves
+    const int x_r = (lane_id % 8) + 8 * (lane_id / 16);
+    const int x_c = (lane_id / 8) % 2;
+    const int x_sw = (x_r >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK;
+    const int x_row_off = x_r * A_COLS;
+    const int b_warp_off = warp_id * NB16;
+    uint32_t x_addr[KPS];
+    #pragma unroll
+    for (int kb = 0; kb < KPS; ++kb)
+        x_addr[kb] = xt_pin(sm_a + 16 * (x_row_off + ((x_c + (sub_k * KPS + kb) * 2) ^ x_sw)));
+    XtDq<bits> dql;
+    dql.init(lane_id << 3);
+    dql.s = (int) xt_pin((uint32_t) dql.s);
+    dql.s4 = (int) xt_pin((uint32_t) dql.s4);
+    XtMul1K K;
+    if constexpr (cb == 2) K.init();
+    FragA ones;                                   // FOLD: all-ones A operand (fp16 1.0)
+    if constexpr (FOLD)
+    {
+        #pragma unroll
+        for (int i = 0; i < 4; ++i) ones[i] = half2_uint32(xt_pin(0x3c003c00u + 0u * i)).as_half2;   // 4 distinct registers
+    }
+    const uint32_t bw_base = sm_b + (sub_k * KPS * TILEBLOCKS_N + b_warp_off) * 32 * bits;
+    const uint32_t bw0 = xt_pin(bw_base + 4 * dql.wi0);
+    const uint32_t bw1 = xt_pin(bw_base + 4 * dql.wi1);
+
+    auto compute = [&] (auto cbuf, auto hic)
+    {
+        constexpr int CB = decltype(cbuf)::value;
+        constexpr bool HI = decltype(hic)::value;
+        xt_unroll<KPS>([&] (auto kbc)
+        {
+            constexpr int kb = decltype(kbc)::value;
+            FragA xs;
+            xt_ldsm4<CB * SA_BYTES>(xs, x_addr[kb]);
+            FragB x0, x1;
+            x0[0] = xs[0]; x0[1] = xs[1]; x1[0] = xs[2]; x1[1] = xs[3];
+            if constexpr (FOLD)
+            {
+                ptx_mma_m16n8k16(ones, x0, frag_x[0]);
+                if constexpr (HI) ptx_mma_m16n8k16(ones, x1, frag_x[1]);
+            }
+            xt_unroll<NB16>([&] (auto cc)
+            {
+                constexpr int c = decltype(cc)::value;
+                constexpr int OFF = CB * SB_BYTES + (kb * TILEBLOCKS_N + c) * 32 * bits;
+                const uint32_t wa0 = xt_lds32<OFF>(bw0);
+                const uint32_t wa1 = xt_lds32<OFF>(bw1);
+                FragB w0, w1;
+                dql.template decode<cb, FOLD>(wa0, wa1, w0, w1, K);
+                FragA wa;   // B fragments of columns 0-7 / 8-15 are the row 0-7 / 8-15 halves of the transposed A fragment
+                wa[0] = w0[0]; wa[1] = w1[0]; wa[2] = w0[1]; wa[3] = w1[1];
+                ptx_mma_m16n8k16(wa, x0, frag_c[0][c]);
+                if constexpr (HI) ptx_mma_m16n8k16(wa, x1, frag_c[1][c]);
+            });
+        });
+    };
+
+    auto clear_frag_c = [&] ()
+    {
+        #pragma unroll
+        for (int h = 0; h < 2; ++h)
+            #pragma unroll
+            for (int c = 0; c < NB16; ++c)
+                frag_c[h][c] = {};
+        if constexpr (FOLD) { frag_x[0] = {}; frag_x[1] = {}; }
+    };
+
+    // ---- reduce: verbatim ds41a (threadblock_reduce, read_sum_gl, write_sum_gl, lock protocol) ----
+    auto threadblock_reduce = [&] ()
+    {
+        const int nh = rows2 > 8 ? 2 : 1;
+        float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+        if (sub_k == 1)
+        {
+            #pragma unroll
+            for (int h = 0; h < 2; ++h)
+                if (h < nh)
+                    #pragma unroll
+                    for (int c = 0; c < NB16; ++c)
+                        #pragma unroll
+                        for (int j = 0; j < 4; ++j) sh_red[(h * NB16 + c) * 4 + j] = frag_c[h][c][j];
+        }
+        __syncthreads();
+        if (sub_k == 0)
+        {
+            #pragma unroll
+            for (int h = 0; h < 2; ++h)
+                if (h < nh)
+                    #pragma unroll
+                    for (int c = 0; c < NB16; ++c)
+                        #pragma unroll
+                        for (int j = 0; j < 4; ++j) frag_c[h][c][j] += sh_red[(h * NB16 + c) * 4 + j];
+        }
+    };
+
+    // C' fragment: c[2 i + tt] = out[token 8 h + 2 (lane % 4) + tt][column 16 block + lane / 4 + 8 i]
+    auto read_sum_gl = [&] ()
+    {
+        const int q = lane_id % 4, r = lane_id / 4;
+        #pragma unroll
+        for (int h = 0; h < 2; ++h)
+            #pragma unroll
+            for (int c = 0; c < NB16; ++c)
+                #pragma unroll
+                for (int i = 0; i < 2; ++i)
+                    #pragma unroll
+                    for (int tt = 0; tt < 2; ++tt)
+                    {
+                        const int tok = 8 * h + 2 * q + tt;
+                        const int col = (b_warp_off + c) * 16 + r + 8 * i;
+                        if (tok < rows2) frag_c[h][c][2 * i + tt] += __half2float(gl_c_ptr_16[tok * size_n + col]);
+                    }
+    };
+
+    auto write_sum_gl = [&] ()
+    {
+        const int q = lane_id % 4, r = lane_id / 4;
+        #pragma unroll
+        for (int h = 0; h < 2; ++h)
+            #pragma unroll
+            for (int c = 0; c < NB16; ++c)
+                #pragma unroll
+                for (int i = 0; i < 2; ++i)
+                    #pragma unroll
+                    for (int tt = 0; tt < 2; ++tt)
+                    {
+                        const int tok = 8 * h + 2 * q + tt;
+                        const int col = (b_warp_off + c) * 16 + r + 8 * i;
+                        if (tok < rows2) gl_c_ptr_16[tok * size_n + col] = __float2half_rn(frag_c[h][c][2 * i + tt]);
+                    }
+    };
+
+    // End of an MMA segment (last k-tile of a column, or of the block's slice range): reduce as ds41a, then step to the
+    // next column. Returns true when the block's slice range is done.
+    auto reduce_advance = [&] () -> bool
+    {
+        if constexpr (FOLD)   // h-space -> w-space, per sub_k group, before the (unchanged) reduce
+        {
+            const float k_inv = __half2float(__ushort_as_half(0x1eee));
+            const float k_bias = __half2float(__ushort_as_half(0xc931));
+            #pragma unroll
+            for (int h = 0; h < 2; ++h)
+                #pragma unroll
+                for (int c = 0; c < NB16; ++c)
+                    #pragma unroll
+                    for (int j = 0; j < 4; ++j) frag_c[h][c][j] = fmaf(k_inv, frag_c[h][c][j], k_bias * frag_x[h][j]);
+        }
+        threadblock_reduce();
+
+        // Partial slices within a column are reduced in reverse k order (see exl3_gemm_kernel_inner)
+        const int slice2_k = cp_k + cp_seg - 1;
+        int lock_i = tiles_k - slice2_k - 1;
+        int lock_d = slice2_k - cp_k + 1;
+        int* lock = &locks[cp_col];
+
+        barrier_acquire(lock, lock_i);
+
+        bool first = lock_i == 0;
+        bool last = lock_i + lock_d == tiles_k;
+
+        if (!sub_k && !first) read_sum_gl();
+        if (!sub_k) write_sum_gl();
+
+        barrier_release(lock, lock_d, last);
+
+        clear_frag_c();
+
+        if (cp_left == 0) return true;
+        ++cp_col;
+        cp_k = 0;
+        if (++cp_n == tiles_n) { cp_n = 0; ++cp_q; }
+        cp_set();
+        return false;
+    };
+
+    // ---- one stage on ring buffer CB: wait for its copies, barrier, refill the buffer computed in the previous stage
+    // with the stage NBUF - 1 ahead, MMAs, segment end. Returns 0 = continue, 1 = slice range done, 2 = the next segment
+    // needs the other HI instance.
+    auto stage = [&] (auto cbuf, auto hic) -> int
+    {
+        constexpr int CB = decltype(cbuf)::value;
+        constexpr bool HI = decltype(hic)::value;
+        cp_async_wait<NBUF - 2>();
+        __syncthreads();
+        ld_issue(std::integral_constant<int, (CB + NBUF - 1) % NBUF>{});
+        cp_async_fence();
+        compute(cbuf, hic);
+        if (--cp_run == 0)
+        {
+            if (reduce_advance()) return 1;
+            if (two_halves != HI) return 2;
+        }
+        return 0;
+    };
+
+    // Runs the ring from buffer `slot` with a fixed HI until the range is done (-1) or HI changes (returns the buffer of
+    // the next stage). Entry at slot > 0 runs the remaining buffers of the ring once before the loop (no jump into it).
+    using B0 = std::integral_constant<int, 0>;
+    using B1 = std::integral_constant<int, 1>;
+    using B2 = std::integral_constant<int, 2>;
+    auto run = [&] (auto hic, int slot) -> int
+    {
+        int r;
+        if constexpr (NBUF == 2)
+        {
+            if (slot == 1) { if ((r = stage(B1{}, hic))) return r == 1 ? -1 : 0; }
+            while (true)
+            {
+                if ((r = stage(B0{}, hic))) return r == 1 ? -1 : 1;
+                if ((r = stage(B1{}, hic))) return r == 1 ? -1 : 0;
+            }
+        }
+        else
+        {
+            if (slot == 1) { if ((r = stage(B1{}, hic))) return r == 1 ? -1 : 2; }
+            if (slot >= 1) { if ((r = stage(B2{}, hic))) return r == 1 ? -1 : 0; }
+            while (true)
+            {
+                if ((r = stage(B0{}, hic))) return r == 1 ? -1 : 1;
+                if ((r = stage(B1{}, hic))) return r == 1 ? -1 : 2;
+                if ((r = stage(B2{}, hic))) return r == 1 ? -1 : 0;
+            }
+        }
+    };
+
+    // ---- prologue: copies of stages 0 .. NBUF - 2 ----
+    xt_unroll<NBUF - 1>([&] (auto bc)
+    {
+        ld_issue(bc);
+        cp_async_fence();
+    });
+
+    clear_frag_c();
+
+    int slot = 0;
+    do slot = two_halves ? run(std::true_type{}, slot) : run(std::false_type{}, slot);
+    while (slot >= 0);
+}
diff -ruN a/quant/exl3_gemm_inner_mt.cuh b/quant/exl3_gemm_inner_mt.cuh
--- a/quant/exl3_gemm_inner_mt.cuh	1969-12-31 16:00:00.000000000 -0800
+++ b/quant/exl3_gemm_inner_mt.cuh	2026-10-20 08:40:39.795718416 -0700
@@ -0,0 +1,732 @@
+#pragma once
+// xmoe: multi-M variant of exl3_gemm_kernel_inner (decode each B tile once, MMA for MT 16-row sub-tiles)
+#include "exl3_gemm_inner.cuh"
+
+template<EXL3_GEMM_T_ARGS, bool shmem_out_had, int MT>
+inline __device__
+void exl3_gemm_kernel_inner_mt
+(
+    const half* __restrict__  A,
+    const uint16_t* __restrict__ B,
+    void* __restrict__ C,
+    const int size_m,
+    const int size_k,
+    const int size_n,
+    int* __restrict__ locks,
+    const half* post_scale,
+    int size_n_stride = 0     // full width of B and C when computing a column slice (0: = size_n)
+)
+{
+    const int TILEBLOCKS_M = TILESIZE_M / 16;
+    if (size_n_stride == 0) size_n_stride = size_n;
+    // Column blocks of the full-width B row: slices index B relative to their own column offset,
+    // but a k-tile row still spans the whole matrix
+    const int blocks_n_full = size_n_stride / 16;
+    const int TILEBLOCKS_K = TILESIZE_K / 16;
+    const int TILEBLOCKS_N = TILESIZE_N / 16;
+    // const int FRAGS_M = TILEBLOCKS_M;
+    const int FRAGS_N_PER_WARP = 2 * TILEBLOCKS_N / (EXL3_GEMM_BASE_THREADS / 32);
+
+    const int sh_a_stage_size = MT * TILESIZE_M * TILESIZE_K;                         // in halfs
+    const int sh_b_stage_size = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;   // in uint16s
+    const int sh_c_size = MAX  // in floats
+    (
+        4 * EXL3_GEMM_BASE_THREADS * FRAGS_N_PER_WARP,
+        shmem_out_had ? TILESIZE_N * TILESIZE_M : 0
+    );
+
+    // XOR-swizzle constants for bank-conflict-free A fragment loads
+    // col_swizzled = col ^ ((row >> SHIFT) & MASK)
+    const int A_COLS = TILESIZE_K / 8;                                            // int4 columns per row
+    const int A_SWIZZLE_MASK = A_COLS - 1;
+    const int A_SWIZZLE_SHIFT = (A_COLS <= 2) ? 2 : 1;
+
+    // Sanity checks
+    static_assert(EXL3_GEMM_BASE_THREADS == 256);
+    static_assert(TILESIZE_M == 16, "Invalid kernel params");
+    static_assert(!shmem_out_had && EXL3_GEMM_H_ACC == 0 && MT >= 1 && MT <= 8, "xmoe mt: unsupported config");                     // strictly assume size_m <= 16
+    static_assert(TILESIZE_K % 16 == 0, "Invalid kernel params");
+    static_assert(TILESIZE_N % 128 == 0, "Invalid kernel params");
+    static_assert
+    (
+        SMEM_MAX >= SH_STAGES * (2 * sh_a_stage_size + 2 * sh_b_stage_size) + 4 * sh_c_size,
+        "Invalid kernel params (insufficient shared memory for shape)"
+    );
+
+    // Shared memory
+    extern __shared__ half shared[];
+    half* sh_a = shared;
+    uint16_t* sh_b = (uint16_t*) (sh_a + SH_STAGES * sh_a_stage_size);
+    float* sh_c = (float*) (sh_b + sh_b_stage_size * SH_STAGES);
+
+    // Thread index
+    int t = threadIdx.x % EXL3_GEMM_BASE_THREADS;
+    int sub_k = threadIdx.x / EXL3_GEMM_BASE_THREADS;
+    int warp_id = t / 32;
+    int lane_id = t % 32;
+
+    // Dimensions
+    //int tiles_m = CEIL_DIVIDE(size_m, TILESIZE_M);
+    int tiles_k = size_k / TILESIZE_K;
+    int tiles_n = size_n / TILESIZE_N;
+    //int blocks_m = 1;
+    //int blocks_k = tiles_k * TILEBLOCKS_K;
+    int blocks_n = tiles_n * TILEBLOCKS_N;
+
+    // Start and end index of current slice, must span at least one tile
+    int num_slices = gridDim.x;
+    int slice_beg = tiles_k * tiles_n * blockIdx.x / num_slices;
+    int slice_end = tiles_k * tiles_n * (blockIdx.x + 1) / num_slices;
+    int slice_len = slice_end - slice_beg;
+    if (slice_len < 1) return;
+
+    auto index_m = [&] (int slice_i) { return 0; }; //blockIdx.y; };
+    auto index_k = [&] (int slice_i) { return (slice_i % tiles_k); };
+    auto index_n = [&] (int slice_i) { return (slice_i / tiles_k); };
+
+    // Batch dimension
+    // int slice_m = index_m(slice_beg);
+    // int max_m = MIN(size_m - slice_m * TILESIZE_M, TILESIZE_M);
+    const int slice_m = 0;
+
+    // Pipe 0, global A, B tile and shared A, B tile
+    int slice0_k = index_k(slice_beg);
+    int slice0_n = index_n(slice_beg);
+    int slice0_iters = slice_len;
+
+    int gl_a_stride_m = TILESIZE_M * size_k;
+    const int gl_a_stride_k = TILESIZE_K;
+    const int sh0_a_stride_m = MT * TILESIZE_M * TILESIZE_K;
+    const half* gl_a_ptr = A + slice_m * gl_a_stride_m + slice0_k * gl_a_stride_k;
+    half* sh0_a_ptr = sh_a + (slice0_iters % SH_STAGES) * sh_a_stage_size;
+
+    const int load_a_iters = CEIL_DIVIDE(sh0_a_stride_m / 8, EXL3_GEMM_BASE_THREADS);
+    bool pred_a_gl[load_a_iters];
+    int load_a_gl[load_a_iters];
+    int load_a_sh[load_a_iters];
+    for (int i = 0; i < load_a_iters; ++i)
+    {
+        int k = (i * EXL3_GEMM_BASE_THREADS + t) % (gl_a_stride_k / 8);
+        int m = (i * EXL3_GEMM_BASE_THREADS + t) / (gl_a_stride_k / 8);
+        load_a_gl[i] = m * size_k / 8 + k;
+        load_a_sh[i] = m * A_COLS + (k ^ ((m >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK));
+        pred_a_gl[i] = m < size_m;
+    }
+
+    int gl_b_stride_k = blocks_n_full * TILEBLOCKS_K * 256 / 16 * bits;
+    const int gl_b_stride_n = TILEBLOCKS_N * 256 / 16 * bits;
+    const int sh0_b_stride_k = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;
+    const uint16_t* gl_b_ptr = B + slice0_k * gl_b_stride_k + slice0_n * gl_b_stride_n;
+    uint16_t* sh0_b_ptr = sh_b + (slice0_iters % SH_STAGES) * sh_b_stage_size;
+
+    const int load_b_iters = CEIL_DIVIDE(sh0_b_stride_k / 8, EXL3_GEMM_BASE_THREADS);
+    bool pred_b_gl[load_b_iters];
+    int load_b_gl[load_b_iters];
+    for (int i = 0; i < load_b_iters; ++i)
+    {
+        int n = (i * EXL3_GEMM_BASE_THREADS + t) % (gl_b_stride_n / 8);
+        int k = (i * EXL3_GEMM_BASE_THREADS + t) / (gl_b_stride_n / 8);
+        load_b_gl[i] = k * (blocks_n_full * 256 / 16 * bits / 8) + n;
+        pred_b_gl[i] = i * EXL3_GEMM_BASE_THREADS + t < sh0_b_stride_k / 8;
+    }
+
+    auto advance0 = [&] ()
+    {
+        slice0_k++;
+        slice0_iters--;
+
+        int stage = slice0_iters % SH_STAGES;
+        sh0_a_ptr = sh_a + stage * sh_a_stage_size;
+        sh0_b_ptr = sh_b + stage * sh_b_stage_size;
+
+        if (slice0_k >= tiles_k)
+        {
+            slice0_k = 0;
+            slice0_n++;
+            gl_a_ptr = A + slice_m * gl_a_stride_m + slice0_k * gl_a_stride_k;
+            gl_b_ptr = B + slice0_k * gl_b_stride_k + slice0_n * gl_b_stride_n;
+        }
+        else
+        {
+            gl_a_ptr += gl_a_stride_k;
+            gl_b_ptr += gl_b_stride_k;
+        }
+    };
+
+    // Pipe 1, shared A, B tile and registers
+    int slice1_k = slice0_k;
+    int slice1_n = slice0_n;
+    int slice1_iters = slice0_iters;
+
+    half* sh1_a_ptr = sh_a + (slice1_iters % SH_STAGES) * sh_a_stage_size;
+    uint16_t* sh1_b_ptr = sh_b + (slice1_iters % SH_STAGES) * sh_b_stage_size;
+
+    auto advance1 = [&] ()
+    {
+        slice1_k++;
+        slice1_iters--;
+
+        int stage = slice1_iters % SH_STAGES;
+        sh1_a_ptr = sh_a + stage * sh_a_stage_size;
+        sh1_b_ptr = sh_b + stage * sh_b_stage_size;
+
+        if (slice1_k >= tiles_k)
+        {
+            slice1_k = 0;
+            slice1_n++;
+        }
+    };
+
+    // Pipe 2
+    int slice2_k = slice0_k;
+    int slice2_k0 = slice0_k;
+    int slice2_n = slice0_n;
+    int slice2_iters = slice0_iters;
+
+    int gl_c_stride_n = TILESIZE_N;
+    int gl_c_stride_m = TILESIZE_M * size_n_stride;
+
+    half* gl_c_ptr_16 = ((half*) C) + slice_m * gl_c_stride_m + slice2_n * gl_c_stride_n;
+    float* gl_c_ptr_32 = ((float*) C) + slice_m * gl_c_stride_m + slice2_n * gl_c_stride_n;
+
+    register FragA frag_a[FRAG_STAGES][MT];
+    register FragB frag_b[FRAG_STAGES][FRAGS_N_PER_WARP];
+    register FragC frag_c[MT][FRAGS_N_PER_WARP];
+    #if EXL3_GEMM_H_ACC
+        register FragC_h frag_c_h[FRAGS_N_PER_WARP];
+    #endif
+
+    auto advance2 = [&] ()
+    {
+        slice2_k++;
+        slice2_iters--;
+
+        if (slice2_k >= tiles_k)
+        {
+            slice2_k = 0;
+            slice2_k0 = 0;
+            slice2_n++;
+            if constexpr (c_fp32)
+                gl_c_ptr_32 += gl_c_stride_n;
+            else
+                gl_c_ptr_16 += gl_c_stride_n;
+        }
+    };
+
+    // Schedule load of the next A, B tiles to shared memory and advance the pipeline
+    auto async_load_gl = [&] ()
+    {
+        if (sub_k)
+        {
+            cp_async_fence();
+            return;
+        }
+
+        if (slice0_iters)
+        {
+            // Copy tile from row-major A matrix (XOR-swizzled for bank-conflict-free ldmatrix)
+            {
+                const int4* gl = (const int4*) gl_a_ptr;
+                int4* sh = (int4*) sh0_a_ptr;
+                #pragma unroll
+                for (int i = 0; i < load_a_iters; ++i)
+                {
+                    if (pred_a_gl[i]) cp_async(sh + load_a_sh[i], gl + load_a_gl[i]);
+                }
+            }
+
+            // Copy tile of 256-element blocks from quantized B matrix
+            {
+                const int4* gl = (const int4*) gl_b_ptr;
+                int4* sh = (int4*) sh0_b_ptr;
+                #pragma unroll
+                for (int i = 0; i < load_b_iters; ++i)
+                {
+                    // cp_async_pred(sh + EXL3_GEMM_BASE_THREADS * i + t, gl + load_b_gl[i], pred_b_gl[i]);
+                    if (pred_b_gl[i]) cp_async(sh + EXL3_GEMM_BASE_THREADS * i + t, gl + load_b_gl[i]);
+                }
+            }
+            advance0();
+        }
+
+        // Sync and advance
+        cp_async_fence();
+    };
+
+    // Load fragments
+    // Ref. for fragment layout:
+    // https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#matrix-fragments-for-mma-m16n8k16-with-floating-point-type
+    auto load_frags = [&] (int buf)
+    {
+        if (!slice1_iters) return;
+
+        // A fragments (XOR-swizzled shared memory layout)
+        {
+            int r = (lane_id % 8) + 8 * ((lane_id / 8) % 2);
+            int base_c = lane_id / 16 + sub_k * 2;
+            #pragma unroll
+            for (int m = 0; m < MT; ++m)
+            {
+                int R = r + m * 16;
+                int c_swizzled = base_c ^ ((R >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK);
+                ldsm4(frag_a[buf][m], (int4*) sh1_a_ptr + R * A_COLS + c_swizzled);
+            }
+        }
+
+        // B fragments
+        #pragma unroll
+        for (int n2 = 0; n2 < FRAGS_N_PER_WARP; n2 += 2)
+        {
+            int sub_n2 = warp_id * FRAGS_N_PER_WARP / 2 + n2 / 2;
+            const uint32_t* shb = (const uint32_t*) (sh1_b_ptr + (sub_k * TILEBLOCKS_N + sub_n2) * 256 / 16 * bits);
+
+            dq_dispatch<bits, cb>(shb, lane_id << 3, frag_b[buf][n2], frag_b[buf][n2 + 1]);
+        }
+#ifndef XMOE_NO_FRAG_SYNC
+
+        __syncthreads();
+#endif
+        advance1();
+    };
+
+    // Clear C fragments
+    auto clear_frag_c = [&] ()
+    {
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        #pragma unroll
+        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            frag_c[mt][n] = {};
+        #if EXL3_GEMM_H_ACC
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                frag_c_h[n] = {};
+        #endif
+    };
+
+    // Threadblock reduction
+    auto threadblock_reduce = [&] (const int mt, const int rows_mt)
+    {
+        auto store = [&] (int i)
+        {
+            if (sub_k == i)
+            {
+                float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    #pragma unroll
+                    for (int j = 0; j < 4; ++j) *sh_red++ = frag_c[mt][n][j];
+                }
+            }
+            __syncthreads();
+        };
+
+        auto add = [&] (int i)
+        {
+            if (sub_k == i)
+            {
+                float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    #pragma unroll
+                    for (int j = 0; j < 4; ++j) frag_c[mt][n][j] += *sh_red++;
+                }
+            }
+        };
+
+        auto store_small = [&] (int i)
+        {
+            if (sub_k == i && lane_id / 4 < rows_mt)
+            {
+                float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    *sh_red++ = frag_c[mt][n][0];
+                    *sh_red++ = frag_c[mt][n][1];
+                }
+            }
+            __syncthreads();
+        };
+
+        auto add_small = [&] (int i)
+        {
+            if (sub_k == i && lane_id / 4 < rows_mt)
+            {
+                float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    frag_c[mt][n][0] += *sh_red++;
+                    frag_c[mt][n][1] += *sh_red++;
+                }
+            }
+        };
+
+        if (rows_mt <= 8)
+        {
+            if constexpr (TILEBLOCKS_K == 2)
+            {
+                store_small(1);
+                add_small(0);
+            }
+            if constexpr (TILEBLOCKS_K == 3)
+            {
+                store_small(1);
+                add_small(0);
+                store_small(2);
+                add_small(0);
+            }
+            if constexpr (TILEBLOCKS_K == 4)
+            {
+                store_small(3);
+                add_small(2);
+                store_small(1);
+                add_small(0);
+                store_small(2);
+                add_small(0);
+            }
+        }
+        else
+        {
+            if constexpr (TILEBLOCKS_K == 2)
+            {
+                store(1);
+                add(0);
+            }
+            if constexpr (TILEBLOCKS_K == 3)
+            {
+                store(1);
+                add(0);
+                store(2);
+                add(0);
+            }
+            if constexpr (TILEBLOCKS_K == 4)
+            {
+                store(3);
+                add(2);
+                store(1);
+                add(0);
+                store(2);
+                add(0);
+            }
+        }
+    };
+
+    // Pre-hadamard: Write final output tile to shmem
+    auto write_sum_tile_sh = [&]()
+    {
+        const int n0 = warp_id * FRAGS_N_PER_WARP;
+        const int r0 = lane_id / 4;
+        const int r1 = r0 + 8;
+        if (r0 < size_m)
+        {
+            const int c = (lane_id % 4) * 2;
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            {
+                float* c_ptr = ((float*) sh_c) + r0 * TILESIZE_N + (n0 + n) * 8 + c;
+                *c_ptr++ = frag_c[0][n][0];
+                *c_ptr++ = frag_c[0][n][1];
+            }
+        }
+        if (r1 < size_m)
+        {
+            const int c = (lane_id % 4) * 2;
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            {
+                float* c_ptr = ((float*) sh_c) + r1 * TILESIZE_N + (n0 + n) * 8 + c;
+                *c_ptr++ = frag_c[0][n][2];
+                *c_ptr++ = frag_c[0][n][3];
+            }
+        }
+    };
+
+    // Copy output tile to global with hadamard transform and out scale
+    auto output_had_sh_gl = [&]()
+    {
+        int sh_warp = warp_id;
+        constexpr int active_warps = EXL3_GEMM_BASE_THREADS / 32;
+        for (;; sh_warp += active_warps)
+        {
+            int col = sh_warp % (TILESIZE_N / 128);
+            int row = sh_warp / (TILESIZE_N / 128);
+            if (row >= size_m) break;
+
+            const float* had_in = sh_c + row * TILESIZE_N + col * 128;
+            const half* post_scale_c = post_scale + slice2_n * gl_c_stride_n + col * 128;
+
+            if constexpr (c_fp32)
+            {
+                float* had_out = gl_c_ptr_32 + row * size_n_stride + col * 128;
+                had_ff_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+            else
+            {
+                half* had_out = gl_c_ptr_16 + row * size_n_stride + col * 128;
+                had_fh_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+        }
+    };
+
+    auto read_sum_gl = [&](const int mt)
+    {
+        int n0 = warp_id * FRAGS_N_PER_WARP;
+        #pragma unroll
+        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+        {
+            int r0 = lane_id / 4;
+            int r1 = r0 + 8;
+            int c = (lane_id % 4) * 2;
+            if (mt * 16 + r0 < size_m)
+            {
+                if constexpr (c_fp32)
+                {
+                    float* c_ptr = gl_c_ptr_32 + (mt * 16 + r0) * size_n_stride + (n0 + n) * 8 + c;
+                    frag_c[mt][n][0] += *c_ptr++;
+                    frag_c[mt][n][1] += *c_ptr++;
+                }
+                else
+                {
+                    half2* c_ptr = (half2*) (gl_c_ptr_16 + (mt * 16 + r0) * size_n_stride + (n0 + n) * 8 + c);
+                    float2 interm = __half22float2(*c_ptr);
+                    frag_c[mt][n][0] += interm.x;
+                    frag_c[mt][n][1] += interm.y;
+                }
+            }
+            if (mt * 16 + r1 < size_m)
+            {
+                if constexpr (c_fp32)
+                {
+                    float* c_ptr = gl_c_ptr_32 + (mt * 16 + r1) * size_n_stride + (n0 + n) * 8 + c;
+                    frag_c[mt][n][2] += *c_ptr++;
+                    frag_c[mt][n][3] += *c_ptr++;
+                }
+                else
+                {
+                    half2* c_ptr = (half2*) (gl_c_ptr_16 + (mt * 16 + r1) * size_n_stride + (n0 + n) * 8 + c);
+                    float2 interm = __half22float2(*c_ptr);
+                    frag_c[mt][n][2] += interm.x;
+                    frag_c[mt][n][3] += interm.y;
+                }
+            }
+        }
+    };
+
+    auto write_sum_gl = [&](const int mt)
+    {
+        int n0 = warp_id * FRAGS_N_PER_WARP;
+        #pragma unroll
+        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+        {
+            int r0 = lane_id / 4;
+            int r1 = r0 + 8;
+            int c = (lane_id % 4) * 2;
+            if (mt * 16 + r0 < size_m)
+            {
+                if constexpr (c_fp32)
+                {
+                    float* c_ptr = gl_c_ptr_32 + (mt * 16 + r0) * size_n_stride + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[mt][n][0];
+                    *c_ptr++ = frag_c[mt][n][1];
+                }
+                else
+                {
+                    half2* c_ptr = (half2*) (gl_c_ptr_16 + (mt * 16 + r0) * size_n_stride + (n0 + n) * 8 + c);
+                    half2 sum = __floats2half2_rn(frag_c[mt][n][0], frag_c[mt][n][1]);
+                    *c_ptr = sum;
+                }
+            }
+            if (mt * 16 + r1 < size_m)
+            {
+                if constexpr (c_fp32)
+                {
+                    float* c_ptr = gl_c_ptr_32 + (mt * 16 + r1) * size_n_stride + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[mt][n][2];
+                    *c_ptr++ = frag_c[mt][n][3];
+                }
+                else
+                {
+                    half2* c_ptr = (half2*) (gl_c_ptr_16 + (mt * 16 + r1) * size_n_stride + (n0 + n) * 8 + c);
+                    half2 sum = __floats2half2_rn(frag_c[mt][n][2], frag_c[mt][n][3]);
+                    *c_ptr = sum;
+                }
+            }
+        }
+    };
+
+    // Output reduction
+    auto reduce = [&] ()
+    {
+        #if EXL3_GEMM_H_ACC
+            // Fold the fp16 MMA accumulators into the fp32 accumulators once per k-slice
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            {
+                float2 f0 = __half22float2(frag_c_h[n][0]);
+                float2 f1 = __half22float2(frag_c_h[n][1]);
+                frag_c[n][0] += f0.x; frag_c[n][1] += f0.y;
+                frag_c[n][2] += f1.x; frag_c[n][3] += f1.y;
+            }
+        #endif
+
+        // First reduce all partial sums along k for the current slice (per 16-row sub-tile)
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        {
+            if (mt) __syncthreads();
+            threadblock_reduce(mt, size_m - mt * 16);
+        }
+
+        // Process (partial) slices within column in reverse order so the threadblock doing the bottom slice is
+        // free to proceed to the next column right away
+        int lock_i = tiles_k - slice2_k - 1;
+        int lock_d = slice2_k - slice2_k0 + 1;
+        int* lock = &locks[slice_m * blocks_n + slice2_n];
+
+        barrier_acquire(lock, lock_i);
+
+        bool first = lock_i == 0;
+        bool last = lock_i + lock_d == tiles_k;
+
+        // Second and subsequent threadblocks in column read back the intermediate sum from global memory
+        if (!sub_k && !first)
+        {
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt) read_sum_gl(mt);
+        }
+
+        // All but last threadblock in column write the intermediate result to global memory
+        if (!sub_k && !last)
+        {
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt) write_sum_gl(mt);
+        }
+
+        // Last block writes in row-major format
+        if (!sub_k && last)
+        {
+            if constexpr (shmem_out_had)
+                write_sum_tile_sh();
+            else
+            {
+                #pragma unroll
+                for (int mt = 0; mt < MT; ++mt) write_sum_gl(mt);
+            }
+        }
+
+        if constexpr (shmem_out_had)
+        {
+            if (last) __syncthreads();
+            if (!sub_k && last)
+                output_had_sh_gl();
+        }
+
+        barrier_release(lock, lock_d, last);
+
+        clear_frag_c();
+    };
+
+    // Wait until there are at most SH_STAGES - 2 async copies pending, i.e. at least one stage has finished loading
+    auto wait_stage = [&] ()
+    {
+        cp_async_wait<SH_STAGES - 2>();
+        __syncthreads();
+    };
+
+    // Perform tensor core matmul on current tile: one decoded B fragment feeds MT 16-row A sub-tiles
+    auto matmul = [&] (int buf)
+    {
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        #pragma unroll
+        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            ptx_mma_m16n8k16(frag_a[buf][mt], frag_b[buf][n], frag_c[mt][n]);
+    };
+
+    // Start global to shared pipeline
+    #pragma unroll
+    for (int i = 0; i < SH_STAGES - 1; ++i)
+        async_load_gl();
+    wait_stage();
+
+    // Start shared to register pipeline.
+    clear_frag_c();
+    if constexpr (FRAG_STAGES > 1)
+        load_frags(0);
+
+    // Main loop. Fragments are double buffered to allow more interleaving. This is especially important to hide the
+    // dequantization overhead, but we need two different iterations of the main loop to avoid confusing the compiler
+    // and making it (sometimes) place the fragment arrays in local memory
+
+    #define FSTAGE_OLD(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        load_frags(_load); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+
+    #define FSTAGE(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+        load_frags(_load); \
+
+    if constexpr (FRAG_STAGES == 1)
+    {
+        while (true)
+        {
+            FSTAGE_OLD(0, 0);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 2)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(0, 1);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 3)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(0, 2);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 4)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(3, 2);
+            FSTAGE(0, 3);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 5)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(3, 2);
+            FSTAGE(4, 3);
+            FSTAGE(0, 4);
+        }
+    }
+}
diff -ruN a/quant/exl3_gemm_inner_mt_pb.cuh b/quant/exl3_gemm_inner_mt_pb.cuh
--- a/quant/exl3_gemm_inner_mt_pb.cuh	1969-12-31 16:00:00.000000000 -0800
+++ b/quant/exl3_gemm_inner_mt_pb.cuh	2026-10-20 08:40:39.799718403 -0700
@@ -0,0 +1,757 @@
+#pragma once
+// xmoe: multi-M variant of exl3_gemm_kernel_inner (decode each B tile once, MMA for MT 16-row sub-tiles)
+// prefillbw (2026-10-20): copy of exl3_gemm_inner_mt.cuh for the cold (host-RAM expert) prefill path of xmoe_ds41pb.
+// Two changes, both value-neutral (same tiles, same MMA/reduction order -> bit-identical results):
+//  * SH_STAGES is a free template parameter here (the caller passes XMOE_PB stage depth 3..8 instead of MOE_SH_STAGES = 3):
+//    with S stages a block keeps S-1 B tiles (S-1 x 1.5 KB for K=3, N=128) of cp.async reads in flight instead of 2.
+//  * stage_out != nullptr: every B tile, once it has landed in shared memory, is also stored (by the thread that loaded it,
+//    16 B per thread) to stage_out at the tile's offset in the trellis layout. The caller runs the first 32-row chunk of a
+//    multi-chunk expert with stage_out set and the remaining chunks with B = stage_out (stage_out = nullptr), so a
+//    host-RAM expert crosses PCIe once per GEMM instead of once per 32 rows (zero-copy reads are not cached on the GPU).
+//    Each block re-reads only the tiles it wrote (same slice, same thread -> same 16-byte pieces).
+#include "exl3_gemm_inner.cuh"
+
+template<EXL3_GEMM_T_ARGS, bool shmem_out_had, int MT>
+inline __device__
+void exl3_gemm_kernel_inner_mt_pb
+(
+    const half* __restrict__  A,
+    const uint16_t* __restrict__ B,
+    void* __restrict__ C,
+    const int size_m,
+    const int size_k,
+    const int size_n,
+    int* __restrict__ locks,
+    const half* post_scale,
+    int size_n_stride = 0,    // full width of B and C when computing a column slice (0: = size_n)
+    uint16_t* __restrict__ stage_out = nullptr   // != nullptr: VRAM copy of B (same layout), written tile by tile
+)
+{
+    const int TILEBLOCKS_M = TILESIZE_M / 16;
+    if (size_n_stride == 0) size_n_stride = size_n;
+    // Column blocks of the full-width B row: slices index B relative to their own column offset,
+    // but a k-tile row still spans the whole matrix
+    const int blocks_n_full = size_n_stride / 16;
+    const int TILEBLOCKS_K = TILESIZE_K / 16;
+    const int TILEBLOCKS_N = TILESIZE_N / 16;
+    // const int FRAGS_M = TILEBLOCKS_M;
+    const int FRAGS_N_PER_WARP = 2 * TILEBLOCKS_N / (EXL3_GEMM_BASE_THREADS / 32);
+
+    const int sh_a_stage_size = MT * TILESIZE_M * TILESIZE_K;                         // in halfs
+    const int sh_b_stage_size = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;   // in uint16s
+    const int sh_c_size = MAX  // in floats
+    (
+        4 * EXL3_GEMM_BASE_THREADS * FRAGS_N_PER_WARP,
+        shmem_out_had ? TILESIZE_N * TILESIZE_M : 0
+    );
+
+    // XOR-swizzle constants for bank-conflict-free A fragment loads
+    // col_swizzled = col ^ ((row >> SHIFT) & MASK)
+    const int A_COLS = TILESIZE_K / 8;                                            // int4 columns per row
+    const int A_SWIZZLE_MASK = A_COLS - 1;
+    const int A_SWIZZLE_SHIFT = (A_COLS <= 2) ? 2 : 1;
+
+    // Sanity checks
+    static_assert(EXL3_GEMM_BASE_THREADS == 256);
+    static_assert(TILESIZE_M == 16, "Invalid kernel params");
+    static_assert(!shmem_out_had && EXL3_GEMM_H_ACC == 0 && MT >= 1 && MT <= 8, "xmoe mt: unsupported config");                     // strictly assume size_m <= 16
+    static_assert(TILESIZE_K % 16 == 0, "Invalid kernel params");
+    static_assert(TILESIZE_N % 128 == 0, "Invalid kernel params");
+    static_assert
+    (
+        SMEM_MAX >= SH_STAGES * (2 * sh_a_stage_size + 2 * sh_b_stage_size) + 4 * sh_c_size,
+        "Invalid kernel params (insufficient shared memory for shape)"
+    );
+
+    // Shared memory
+    extern __shared__ half shared[];
+    half* sh_a = shared;
+    uint16_t* sh_b = (uint16_t*) (sh_a + SH_STAGES * sh_a_stage_size);
+    float* sh_c = (float*) (sh_b + sh_b_stage_size * SH_STAGES);
+
+    // Thread index
+    int t = threadIdx.x % EXL3_GEMM_BASE_THREADS;
+    int sub_k = threadIdx.x / EXL3_GEMM_BASE_THREADS;
+    int warp_id = t / 32;
+    int lane_id = t % 32;
+
+    // Dimensions
+    //int tiles_m = CEIL_DIVIDE(size_m, TILESIZE_M);
+    int tiles_k = size_k / TILESIZE_K;
+    int tiles_n = size_n / TILESIZE_N;
+    //int blocks_m = 1;
+    //int blocks_k = tiles_k * TILEBLOCKS_K;
+    int blocks_n = tiles_n * TILEBLOCKS_N;
+
+    // Start and end index of current slice, must span at least one tile
+    int num_slices = gridDim.x;
+    int slice_beg = tiles_k * tiles_n * blockIdx.x / num_slices;
+    int slice_end = tiles_k * tiles_n * (blockIdx.x + 1) / num_slices;
+    int slice_len = slice_end - slice_beg;
+    if (slice_len < 1) return;
+
+    auto index_m = [&] (int slice_i) { return 0; }; //blockIdx.y; };
+    auto index_k = [&] (int slice_i) { return (slice_i % tiles_k); };
+    auto index_n = [&] (int slice_i) { return (slice_i / tiles_k); };
+
+    // Batch dimension
+    // int slice_m = index_m(slice_beg);
+    // int max_m = MIN(size_m - slice_m * TILESIZE_M, TILESIZE_M);
+    const int slice_m = 0;
+
+    // Pipe 0, global A, B tile and shared A, B tile
+    int slice0_k = index_k(slice_beg);
+    int slice0_n = index_n(slice_beg);
+    int slice0_iters = slice_len;
+
+    int gl_a_stride_m = TILESIZE_M * size_k;
+    const int gl_a_stride_k = TILESIZE_K;
+    const int sh0_a_stride_m = MT * TILESIZE_M * TILESIZE_K;
+    const half* gl_a_ptr = A + slice_m * gl_a_stride_m + slice0_k * gl_a_stride_k;
+    half* sh0_a_ptr = sh_a + (slice0_iters % SH_STAGES) * sh_a_stage_size;
+
+    const int load_a_iters = CEIL_DIVIDE(sh0_a_stride_m / 8, EXL3_GEMM_BASE_THREADS);
+    bool pred_a_gl[load_a_iters];
+    int load_a_gl[load_a_iters];
+    int load_a_sh[load_a_iters];
+    for (int i = 0; i < load_a_iters; ++i)
+    {
+        int k = (i * EXL3_GEMM_BASE_THREADS + t) % (gl_a_stride_k / 8);
+        int m = (i * EXL3_GEMM_BASE_THREADS + t) / (gl_a_stride_k / 8);
+        load_a_gl[i] = m * size_k / 8 + k;
+        load_a_sh[i] = m * A_COLS + (k ^ ((m >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK));
+        pred_a_gl[i] = m < size_m;
+    }
+
+    int gl_b_stride_k = blocks_n_full * TILEBLOCKS_K * 256 / 16 * bits;
+    const int gl_b_stride_n = TILEBLOCKS_N * 256 / 16 * bits;
+    const int sh0_b_stride_k = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;
