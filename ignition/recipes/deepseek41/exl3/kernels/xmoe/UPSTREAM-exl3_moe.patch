+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(0, 2);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 4)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(3, 2);
+            FSTAGE(0, 3);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 5)
+    {
+        while (true)
+        {
+            FSTAGE(1, 0);
+            FSTAGE(2, 1);
+            FSTAGE(3, 2);
+            FSTAGE(4, 3);
+            FSTAGE(0, 4);
+        }
+    }
+}
