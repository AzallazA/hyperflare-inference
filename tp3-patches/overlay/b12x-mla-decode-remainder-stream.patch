+def _env_decode_remainder_stream() -> bool:
+    raw = os.environ.get(_MLA_SM120_DECODE_REMAINDER_STREAM_ENV)
+    return raw is not None and raw.strip().lower() in {"1", "true", "on", "yes"}
+
+
+def _decode_remainder_stream(device: torch.device) -> torch.cuda.Stream:
+    """One non-blocking side stream per device, created on first use.
+
+    Created with cuStreamCreate rather than taken from PyTorch's round-robin
+    pool, which can alias a later capture stream (same reason as Flare's
+    ScratchArena.auxiliary_stream)."""
+    index = device.index if device.index is not None else torch.cuda.current_device()
+    stream = _DECODE_REMAINDER_STREAMS.get(index)
+    if stream is None:
+        with torch.cuda.device(index):
+            status, handle = cuda.cuStreamCreate(
+                cuda.CUstream_flags.CU_STREAM_NON_BLOCKING
+            )
+            if status != cuda.CUresult.CUDA_SUCCESS:
+                raise RuntimeError(f"cannot create decode remainder stream: {status}")
+            stream = torch.cuda.ExternalStream(
+                int(handle), device=torch.device("cuda", index)
+            )
+        _DECODE_REMAINDER_STREAMS[index] = stream
+    return stream
+
+
+def _launch_head_blocks(full, remainder, side_stream=None, current_stream=None):
+    """Launch the full-block grid, then the remainder grid.
+
+    ``full`` / ``remainder`` are zero-argument launchers or ``None``.  Without a
+    ``side_stream`` (or with only one grid) both run in order on the current
+    stream (today's behaviour).  With one, the remainder runs on ``side_stream``
+    after it waits for the current stream, and the current stream waits for it
+    before anything later (the split merge) is enqueued.  The call order stays
+    full, remainder, so prepared program lists keep their indices."""
+    if side_stream is None or full is None or remainder is None:
+        if full is not None:
+            full()
+        if remainder is not None:
+            remainder()
+        return
+    main = torch.cuda.current_stream() if current_stream is None else current_stream
+    side_stream.wait_stream(main)
+    full()
+    with torch.cuda.stream(side_stream):
+        remainder()
+    main.wait_stream(side_stream)
+
